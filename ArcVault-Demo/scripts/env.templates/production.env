# ArcVault Production Environment Configuration
# Copy this file to .env and modify for your production deployment

# =============================================================================
# BACKUP AGENT CONFIGURATION
# =============================================================================

# Basic Agent Settings
AGENT_LISTEN_HOST=0.0.0.0
AGENT_PORT=443
AGENT_PUBLIC_HOST=your-agent-hostname.domain.com
AGENT_PUBLIC_URL=https://your-agent-hostname.domain.com:443
AGENT_PUBLIC_SCHEME=https

# Authentication - Production Mode (JWT with RSA keys) - REQUIRED
AGENT_REQUIRE_JWT=true
AGENT_JWT_PUBLIC_KEY_PATH=/opt/arcvault/keys/controller_public.pem
AGENT_JWT_ISSUER=backup-controller
AGENT_JWT_AUDIENCE=backup-agent
AGENT_JWT_LEEWAY=60

# Static token fallback - DISABLED in production
# AGENT_TOKEN=your-secure-static-token-here

# SSL/TLS Configuration - REQUIRED for production
# Use self-signed certificates (generated by ArcVault-Cert-Generator.exe)
AGENT_CERTFILE=/opt/arcvault/keys/server.crt
AGENT_KEYFILE=/opt/arcvault/keys/server.key
AGENT_VERIFY_SSL=false
AGENT_CA_BUNDLE=/opt/arcvault/keys/ca-bundle.crt

# =============================================================================
# BACKUP CONTROLLER CONFIGURATION
# =============================================================================

# Basic Controller Settings
CONTROLLER_PORT=8501
CONTROLLER_ADDRESS=0.0.0.0
STREAMLIT_HEADLESS=1

# Agent Connection - Update with your agent hostnames
AGENT_URL=https://your-agent-hostname.domain.com:443

# Authentication - Production Mode (JWT with RSA keys) - REQUIRED
CTRL_JWT_PRIVATE_KEY_PATH=/opt/arcvault/keys/controller_private.pem
CTRL_JWT_ISSUER=backup-controller
CTRL_JWT_AUDIENCE=backup-agent

# Static token fallback - DISABLED in production
# AGENT_TOKEN=your-secure-static-token-here

# SSL/TLS Configuration for Agent Communication - REQUIRED
# Use self-signed certificates (disable verification for internal use)
AGENT_VERIFY_SSL=false
AGENT_CA_BUNDLE=/opt/arcvault/keys/ca-bundle.crt

# =============================================================================
# BACKUP ENGINE CONFIGURATION
# =============================================================================

# Robocopy Production Settings (optimized for reliability)
ROBOCOPY_DEFAULT_RETRIES=3
ROBOCOPY_DEFAULT_WAIT=10
ROBOCOPY_DEFAULT_THREADS=16
ROBOCOPY_DEFAULT_VERBOSE=true
ROBOCOPY_DEFAULT_INCLUDE_EMPTY=true
ROBOCOPY_DEFAULT_REPORT_EXTRAS=true
ROBOCOPY_DEFAULT_REMOVE_SYSTEM_HIDDEN=true

# Logging Configuration
BACKUP_LOG_LEVEL=INFO
BACKUP_LOG_DIR=#backup_logs

# =============================================================================
# UPDATE SYSTEM CONFIGURATION
# =============================================================================

# Update Checker Settings
ARCVault_EXPECTED_PUBLISHER=CN=Your Company Name, O=Your Organization
UPDATE_CHECK_INTERVAL=24
UPDATE_AUTO_INSTALL=false

# =============================================================================
# PRODUCTION SPECIFIC
# =============================================================================

# Python Environment
PYTHONPATH=/opt/arcvault
PYTHONUNBUFFERED=1

# Production Settings
DEBUG=false
LOG_LEVEL=INFO

# Security Settings
AGENT_ALLOWED_HOSTS=your-agent-hostname.domain.com,your-controller-hostname.domain.com
CONTROLLER_ALLOWED_HOSTS=your-controller-hostname.domain.com
