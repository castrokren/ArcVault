# ArcVault Development Environment Configuration
# Copy this file to .env and modify as needed for your development setup

# =============================================================================
# BACKUP AGENT CONFIGURATION
# =============================================================================

# Basic Agent Settings
AGENT_LISTEN_HOST=0.0.0.0
AGENT_PORT=8443
AGENT_PUBLIC_HOST=localhost
AGENT_PUBLIC_URL=http://localhost:8443
AGENT_PUBLIC_SCHEME=http

# Authentication - Development Mode (Simple Token)
AGENT_TOKEN=dev-token-12345
AGENT_REQUIRE_JWT=false

# Authentication - Production Mode (JWT with RSA keys) - DISABLED FOR DEV
# AGENT_REQUIRE_JWT=true
# AGENT_JWT_PUBLIC_KEY_PATH=keys/controller_public.pem
# AGENT_JWT_ISSUER=backup-controller
# AGENT_JWT_AUDIENCE=backup-agent
# AGENT_JWT_LEEWAY=60

# SSL/TLS Configuration (Optional for development)
# AGENT_CERTFILE=keys/agent.crt
# AGENT_KEYFILE=keys/agent.key
# AGENT_VERIFY_SSL=false
# AGENT_CA_BUNDLE=keys/ca-bundle.crt

# =============================================================================
# BACKUP CONTROLLER CONFIGURATION
# =============================================================================

# Basic Controller Settings
CONTROLLER_PORT=8501
CONTROLLER_ADDRESS=0.0.0.0
STREAMLIT_HEADLESS=0

# Agent Connection
AGENT_URL=http://localhost:8443

# Authentication - Development Mode
AGENT_TOKEN=dev-token-12345

# Authentication - Production Mode (JWT with RSA keys) - DISABLED FOR DEV
# CTRL_JWT_PRIVATE_KEY_PATH=keys/controller_private.pem
# CTRL_JWT_ISSUER=backup-controller
# CTRL_JWT_AUDIENCE=backup-agent

# SSL/TLS Configuration for Agent Communication
AGENT_VERIFY_SSL=false
# AGENT_CA_BUNDLE=keys/ca-bundle.crt

# =============================================================================
# BACKUP ENGINE CONFIGURATION
# =============================================================================

# Robocopy Default Options
ROBOCOPY_DEFAULT_RETRIES=1
ROBOCOPY_DEFAULT_WAIT=5
ROBOCOPY_DEFAULT_THREADS=12
ROBOCOPY_DEFAULT_VERBOSE=true
ROBOCOPY_DEFAULT_INCLUDE_EMPTY=true
ROBOCOPY_DEFAULT_REPORT_EXTRAS=true
ROBOCOPY_DEFAULT_REMOVE_SYSTEM_HIDDEN=true

# Logging Configuration
BACKUP_LOG_LEVEL=INFO
BACKUP_LOG_DIR=#backup_logs

# =============================================================================
# UPDATE SYSTEM CONFIGURATION
# =============================================================================

# Update Checker Settings
ARCVault_EXPECTED_PUBLISHER=CN=Your Company Name, O=Your Organization
UPDATE_CHECK_INTERVAL=24
UPDATE_AUTO_INSTALL=false

# =============================================================================
# DEVELOPMENT SPECIFIC
# =============================================================================

# Python Environment
PYTHONPATH=.
PYTHONUNBUFFERED=1

# Debug Settings
DEBUG=true
LOG_LEVEL=DEBUG
