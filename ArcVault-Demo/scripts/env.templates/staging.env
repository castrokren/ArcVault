# ArcVault Staging Environment Configuration
# Copy this file to .env and modify for your staging/test deployment

# =============================================================================
# BACKUP AGENT CONFIGURATION
# =============================================================================

# Basic Agent Settings
AGENT_LISTEN_HOST=0.0.0.0
AGENT_PORT=8443
AGENT_PUBLIC_HOST=staging-agent.yourdomain.com
AGENT_PUBLIC_URL=https://staging-agent.yourdomain.com:8443
AGENT_PUBLIC_SCHEME=https

# Authentication - Staging Mode (JWT with RSA keys) - RECOMMENDED
AGENT_REQUIRE_JWT=true
AGENT_JWT_PUBLIC_KEY_PATH=keys/controller_public.pem
AGENT_JWT_ISSUER=backup-controller-staging
AGENT_JWT_AUDIENCE=backup-agent-staging
AGENT_JWT_LEEWAY=60

# Static token fallback - Available but not recommended
AGENT_TOKEN=staging-token-67890

# SSL/TLS Configuration - RECOMMENDED for staging
# AGENT_CERTFILE=keys/agent.crt
# AGENT_KEYFILE=keys/agent.key
AGENT_VERIFY_SSL=false
# AGENT_CA_BUNDLE=keys/ca-bundle.crt

# =============================================================================
# BACKUP CONTROLLER CONFIGURATION
# =============================================================================

# Basic Controller Settings
CONTROLLER_PORT=8501
CONTROLLER_ADDRESS=0.0.0.0
STREAMLIT_HEADLESS=1

# Agent Connection
AGENT_URL=https://staging-agent.yourdomain.com:8443

# Authentication - Staging Mode (JWT with RSA keys) - RECOMMENDED
CTRL_JWT_PRIVATE_KEY_PATH=keys/controller_private.pem
CTRL_JWT_ISSUER=backup-controller-staging
CTRL_JWT_AUDIENCE=backup-agent-staging

# Static token fallback - Available but not recommended
AGENT_TOKEN=staging-token-67890

# SSL/TLS Configuration for Agent Communication
AGENT_VERIFY_SSL=false
# AGENT_CA_BUNDLE=keys/ca-bundle.crt

# =============================================================================
# BACKUP ENGINE CONFIGURATION
# =============================================================================

# Robocopy Staging Settings (balanced for testing)
ROBOCOPY_DEFAULT_RETRIES=2
ROBOCOPY_DEFAULT_WAIT=7
ROBOCOPY_DEFAULT_THREADS=8
ROBOCOPY_DEFAULT_VERBOSE=true
ROBOCOPY_DEFAULT_INCLUDE_EMPTY=true
ROBOCOPY_DEFAULT_REPORT_EXTRAS=true
ROBOCOPY_DEFAULT_REMOVE_SYSTEM_HIDDEN=true

# Logging Configuration
BACKUP_LOG_LEVEL=DEBUG
BACKUP_LOG_DIR=#backup_logs

# =============================================================================
# UPDATE SYSTEM CONFIGURATION
# =============================================================================

# Update Checker Settings
ARCVault_EXPECTED_PUBLISHER=CN=Your Company Name, O=Your Organization
UPDATE_CHECK_INTERVAL=12
UPDATE_AUTO_INSTALL=false

# =============================================================================
# STAGING SPECIFIC
# =============================================================================

# Python Environment
PYTHONPATH=.
PYTHONUNBUFFERED=1

# Staging Settings
DEBUG=true
LOG_LEVEL=DEBUG

# Test Data Settings
STAGING_MODE=true
TEST_BACKUP_PATHS=C:\temp\test-backup
